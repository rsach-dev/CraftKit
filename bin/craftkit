#!/bin/sh
# craftkit — install and maintain CraftKit in any repository.
#
#   craftkit init [--harnesses a,b]  vendor the kit, generate config + shims
#                             (a harness is required; re-run init to add more)
#   craftkit sync             regenerate harness shims from the kit + project.yaml
#   craftkit update [--to V]  replace ./.craftkit with a newer kit version, re-sync
#   craftkit doctor           validate the installation
#   craftkit stacks           list available stack packs
#   craftkit version          print installed kit version
#
# Source resolution (init/update): $CRAFTKIT_SRC may be a local checkout of the
# craftkit repo or a git URL; defaults to $CRAFTKIT_REPO below.
set -eu

CRAFTKIT_REPO="${CRAFTKIT_REPO:-https://github.com/rsach-dev/CraftKit.git}"
REPO_ROOT="$(pwd)"
KIT_DIR="$REPO_ROOT/.craftkit"
PROJ_DIR="$REPO_ROOT/.craftkit-project"

say()  { printf '%s\n' "$*"; }
warn() { printf 'craftkit: %s\n' "$*" >&2; }
die()  { warn "$*"; exit 1; }

# ---------------------------------------------------------------- source kit
# Sets $SRC to a local directory containing the kit repo (kit/, adapters/, …).
fetch_source() { # $1 = optional git ref
  ref="${1:-}"
  if [ -n "${CRAFTKIT_SRC:-}" ] && [ -d "$CRAFTKIT_SRC/kit" ]; then
    SRC="$CRAFTKIT_SRC"
    return 0
  fi
  command -v git >/dev/null || die "git is required"
  SRC=$(mktemp -d)
  trap 'rm -rf "$SRC"' EXIT
  if [ -n "$ref" ]; then
    git clone -q --depth 1 --branch "$ref" "${CRAFTKIT_SRC:-$CRAFTKIT_REPO}" "$SRC" \
      || die "could not clone ${CRAFTKIT_SRC:-$CRAFTKIT_REPO} at $ref"
  else
    git clone -q --depth 1 "${CRAFTKIT_SRC:-$CRAFTKIT_REPO}" "$SRC" \
      || die "could not clone ${CRAFTKIT_SRC:-$CRAFTKIT_REPO}"
  fi
}

# ------------------------------------------------------------- vendor + sync
vendor_kit() { # copies kit content from $SRC into .craftkit (kit-owned, replaced wholesale)
  [ -d "$SRC/kit" ] || die "source does not look like a craftkit repo (no kit/ dir): $SRC"
  rm -rf "$KIT_DIR"
  mkdir -p "$KIT_DIR"
  cp -R "$SRC/kit/skills" "$SRC/kit/workflows" "$SRC/kit/templates" "$KIT_DIR/"
  if [ -d "$SRC/kit/stacks" ]; then cp -R "$SRC/kit/stacks" "$KIT_DIR/"; fi
  mkdir -p "$KIT_DIR/adapters" "$KIT_DIR/bin"
  cp "$SRC"/adapters/*.sh "$KIT_DIR/adapters/"
  cp "$SRC/bin/craftkit" "$KIT_DIR/bin/craftkit"
  chmod +x "$KIT_DIR/bin/craftkit" "$KIT_DIR/adapters/"*.sh
  KIT_VERSION=$(cat "$SRC/VERSION" 2>/dev/null || echo "0.0.0")
  printf '%s\n' "$KIT_VERSION" > "$KIT_DIR/KIT_VERSION"
  # Manifest for doctor's divergence check (excludes itself).
  (cd "$KIT_DIR" && find . -type f ! -name MANIFEST | LC_ALL=C sort | xargs cksum > MANIFEST)
}

# ----------------------------------------------------------------- harnesses
all_harnesses() { # every adapter shipped in the vendored kit
  for a in "$KIT_DIR"/adapters/*.sh; do
    [ -f "$a" ] || continue
    basename "$a" .sh
  done
}

enabled_harnesses() { # from project.yaml's `harnesses: [a, b]`; pre-0.3 files lack the key -> all
  if [ -f "$PROJ_DIR/project.yaml" ]; then
    h=$(sed -n 's/^harnesses:[[:space:]]*\[\(.*\)\].*/\1/p' "$PROJ_DIR/project.yaml" | head -1 | tr ',' ' ')
    if [ -n "$h" ]; then
      for w in $h; do printf '%s\n' "$w"; done
      return 0
    fi
  fi
  all_harnesses
}

# Sets $HARNESSES (space-separated). $1 = comma list from --harnesses (may be
# empty), $2 = currently enabled harnesses (space-separated; empty on a fresh
# init). A selection is required on fresh init; on re-init the selection is
# merged into the current list (re-run init to add a harness later).
choose_harnesses() {
  avail=$(all_harnesses)
  sel="${1:-}"
  current="${2:-}"
  if [ -z "$sel" ] && [ -t 0 ] && [ -t 1 ] && [ -r /dev/tty ]; then
    say ""
    say "Which agent harnesses should CraftKit wire up?"
    i=0
    for h in $avail; do
      i=$((i+1))
      case " $current " in
        *" $h "*) say "  $i) $h (already enabled)";;
        *)        say "  $i) $h";;
      esac
    done
    if [ -n "$current" ]; then
      printf 'Add harnesses (names or numbers, comma-separated; Enter = keep current): '
      read -r sel < /dev/tty || sel=""
    else
      while [ -z "$sel" ]; do
        printf 'Enable (names or numbers, comma-separated, or "all"): '
        read -r sel < /dev/tty || { sel=""; break; }
        [ -n "$sel" ] || say "  at least one harness is required"
      done
    fi
  fi
  if [ -z "$sel" ]; then
    [ -n "$current" ] || die "a harness is required: craftkit init --harnesses claude-code[,copilot-cli,pi]"
    HARNESSES="$current"
    return 0
  fi
  [ "$sel" = "all" ] && sel=$(echo $avail | tr ' ' ',')
  HARNESSES="$current"
  for tok in $(printf '%s' "$sel" | tr ',' ' '); do
    pick=""
    i=0
    for h in $avail; do
      i=$((i+1))
      { [ "$tok" = "$h" ] || [ "$tok" = "$i" ]; } && pick="$h"
    done
    [ -n "$pick" ] || die "unknown harness: $tok (available: $(echo $avail))"
    case " $HARNESSES " in *" $pick "*) ;; *) HARNESSES="$HARNESSES $pick";; esac
  done
  HARNESSES=${HARNESSES# }
}

write_harnesses() { # rewrite the harnesses: line in an existing project.yaml
  hy=$(echo $HARNESSES | sed 's/ /, /g')
  tmp=$(mktemp)
  if grep -q '^harnesses:' "$PROJ_DIR/project.yaml"; then
    sed "s|^harnesses:.*|harnesses: [$hy]|" "$PROJ_DIR/project.yaml" > "$tmp"
  else
    awk -v line="harnesses: [$hy]" '{print} /^kit_version:/{print line}' "$PROJ_DIR/project.yaml" > "$tmp"
  fi
  mv "$tmp" "$PROJ_DIR/project.yaml"
  say "  updated:        .craftkit-project/project.yaml (harnesses: [$hy])"
}

run_sync() {
  [ -d "$KIT_DIR/adapters" ] || die "no .craftkit/adapters — run 'craftkit init' first"
  for h in $(enabled_harnesses); do
    a="$KIT_DIR/adapters/$h.sh"
    [ -f "$a" ] || { warn "no adapter for harness '$h' (check project.yaml) — skipping"; continue; }
    sh "$a" "$REPO_ROOT"
  done
}

# ---------------------------------------------------------------- detection
detect_repo() {
  REPO_NAME=$(basename "$REPO_ROOT")
  # Most common UPPERCASE-123 ticket prefix in git history, fallback PROJ.
  TICKET_PREFIX=$(git log --oneline -500 2>/dev/null \
    | grep -oE '\b[A-Z][A-Z0-9]{1,9}-[0-9]+' \
    | cut -d- -f1 | sort | uniq -c | sort -rn | head -1 | awk '{print $2}') || true
  [ -n "${TICKET_PREFIX:-}" ] || TICKET_PREFIX="PROJ"

  STACK_PACK=""
  if [ -f "$REPO_ROOT/gradlew" ] || [ -f "$REPO_ROOT/build.gradle" ] || [ -f "$REPO_ROOT/build.gradle.kts" ]; then
    STACK="JVM / Gradle"; BUILD_CMD="./gradlew build"; TEST_CMD="./gradlew test"; PROTECTED_GLOB="config/**"
    for f in "$REPO_ROOT/build.gradle" "$REPO_ROOT/build.gradle.kts" "$REPO_ROOT"/gradle/*.versions.toml; do
      if [ -f "$f" ] && grep -Eq 'spring-boot|org\.springframework\.boot' "$f"; then STACK_PACK="java21-spring-gradle"; break; fi
    done
  elif [ -f "$REPO_ROOT/pom.xml" ]; then
    STACK="JVM / Maven"; BUILD_CMD="mvn -B verify"; TEST_CMD="mvn -B test"; PROTECTED_GLOB="config/**"
  elif [ -f "$REPO_ROOT/package.json" ]; then
    STACK="Node.js / npm"; BUILD_CMD="npm run build"; TEST_CMD="npm test"; PROTECTED_GLOB=".eslintrc*"
  elif [ -f "$REPO_ROOT/Cargo.toml" ]; then
    STACK="Rust / Cargo"; BUILD_CMD="cargo build"; TEST_CMD="cargo test"; PROTECTED_GLOB="deny.toml"
  elif [ -f "$REPO_ROOT/go.mod" ]; then
    STACK="Go"; BUILD_CMD="go build ./..."; TEST_CMD="go test ./..."; PROTECTED_GLOB=".golangci*"
  elif [ -f "$REPO_ROOT/pyproject.toml" ] || [ -f "$REPO_ROOT/setup.py" ]; then
    STACK="Python"; BUILD_CMD="pytest"; TEST_CMD="pytest"; PROTECTED_GLOB="pyproject.toml"
  else
    STACK="unknown — edit project.yaml"; BUILD_CMD="echo 'set build command in project.yaml'"; TEST_CMD="echo 'set test command in project.yaml'"; PROTECTED_GLOB="config/**"
  fi
}

fill_template() { # $1=template $2=destination (skipped if destination exists)
  [ -f "$2" ] && { say "  exists, kept:   ${2#"$REPO_ROOT"/}"; return 0; }
  sed -e "s|{{REPO_NAME}}|$REPO_NAME|g" \
      -e "s|{{KIT_VERSION}}|$KIT_VERSION|g" \
      -e "s|{{TICKET_PREFIX}}|$TICKET_PREFIX|g" \
      -e "s|{{MODULE_NAME}}|$REPO_NAME|g" \
      -e "s|{{MODULE_PATH}}|.|g" \
      -e "s|{{STACK}}|$STACK|g" \
      -e "s|{{BUILD_CMD}}|$BUILD_CMD|g" \
      -e "s|{{TEST_CMD}}|$TEST_CMD|g" \
      -e "s|{{PROTECTED_GLOB}}|$PROTECTED_GLOB|g" \
      -e "s|{{STACK_PACK}}|$STACK_PACK|g" \
      -e "s|{{HARNESSES}}|$(echo $HARNESSES | sed 's/ /, /g')|g" \
      "$1" > "$2"
  say "  generated:      ${2#"$REPO_ROOT"/}"
}

# ------------------------------------------------------------------ commands
cmd_init() {
  hsel=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --harnesses)   hsel="${2:?usage: craftkit init [--harnesses claude-code,copilot-cli,pi]}"; shift 2;;
      --harnesses=*) hsel="${1#--harnesses=}"; shift;;
      *) die "unknown option: $1 (try 'craftkit help')";;
    esac
  done
  [ -d "$REPO_ROOT/.git" ] || warn "not a git repository root — continuing anyway"
  fetch_source ""
  say "Vendoring kit into .craftkit/ ..."
  vendor_kit
  say "Kit version: $KIT_VERSION"

  current=""
  [ -f "$PROJ_DIR/project.yaml" ] && current=$(echo $(enabled_harnesses))
  choose_harnesses "$hsel" "$current"
  say "Harnesses: $HARNESSES"
  if [ -f "$PROJ_DIR/project.yaml" ] && [ "$HARNESSES" != "$current" ]; then
    write_harnesses
  fi

  detect_repo
  say "Detected: repo=$REPO_NAME stack=\"$STACK\" ticket-prefix=$TICKET_PREFIX stack-pack=${STACK_PACK:-none}"
  say "Generating repo-owned files (existing files are never overwritten):"
  mkdir -p "$PROJ_DIR/context/profiles" "$PROJ_DIR/overrides"
  fill_template "$KIT_DIR/templates/project.yaml.tmpl" "$PROJ_DIR/project.yaml"
  fill_template "$KIT_DIR/templates/AGENTS.md.tmpl"    "$REPO_ROOT/AGENTS.md"
  fill_template "$KIT_DIR/templates/ONBOARDING.md.tmpl" "$REPO_ROOT/ONBOARDING.md"

  say "Generating harness shims ..."
  run_sync

  cat <<EOF

CraftKit $KIT_VERSION installed.

Next steps:
  1. Open your agent harness and run /ck-init to finish setup (reviews
     project.yaml, assigns stack packs, generates context files)
     — or do it by hand: review .craftkit-project/project.yaml, then run /ck-context-sync
  2. New to the kit? Run /ck-onboard
  3. Commit: .craftkit/ .craftkit-project/ AGENTS.md ONBOARDING.md plus the
     generated harness files (CLAUDE.md .claude/ .github/ .pi/ — only the
     harnesses you enabled)
EOF
}

cmd_update() {
  [ -d "$KIT_DIR" ] || die "no .craftkit found — run 'craftkit init' first"
  ref=""
  [ "${1:-}" = "--to" ] && { ref="${2:?usage: craftkit update --to X.Y.Z}"; }
  old=$(cat "$KIT_DIR/KIT_VERSION" 2>/dev/null || echo "unknown")
  fetch_source "${ref:+v$ref}"
  vendor_kit
  run_sync
  say "CraftKit updated: $old -> $KIT_VERSION"
  [ -f "$SRC/CHANGELOG.md" ] && { say ""; say "Changelog (top):"; head -30 "$SRC/CHANGELOG.md"; }
  say "Repo-owned files (.craftkit-project/, AGENTS.md, ONBOARDING.md, artifacts/) were not touched."
}

cmd_doctor() {
  fail=0
  ok()   { say "  ok    $1"; }
  bad()  { say "  FAIL  $1"; fail=1; }
  note() { say "  warn  $1"; }

  say "craftkit doctor:"
  [ -d "$KIT_DIR" ] && ok ".craftkit present (v$(cat "$KIT_DIR/KIT_VERSION" 2>/dev/null || echo '?'))" || bad ".craftkit missing — run 'craftkit init'"
  [ -f "$PROJ_DIR/project.yaml" ] && ok "project.yaml present" || bad "project.yaml missing"
  if [ -f "$PROJ_DIR/project.yaml" ]; then
    grep -q '^modules:' "$PROJ_DIR/project.yaml" && ok "project.yaml has modules" || bad "project.yaml has no modules section"
    pinned=$(sed -n 's/^kit_version:[[:space:]]*//p' "$PROJ_DIR/project.yaml" | head -1)
    actual=$(cat "$KIT_DIR/KIT_VERSION" 2>/dev/null || echo "")
    [ "$pinned" = "$actual" ] && ok "kit_version matches installed kit ($actual)" || note "project.yaml kit_version ($pinned) != installed ($actual) — update project.yaml"
  fi

  # Kit divergence (hand edits under .craftkit are lost on update).
  if [ -f "$KIT_DIR/MANIFEST" ]; then
    if (cd "$KIT_DIR" && find . -type f ! -name MANIFEST | LC_ALL=C sort | xargs cksum | diff -q - MANIFEST >/dev/null 2>&1); then
      ok ".craftkit matches its manifest (no hand edits)"
    else
      note ".craftkit diverges from its manifest — hand edits will be LOST on update; use .craftkit-project/overrides/ instead"
    fi
  fi

  # Shims in sync — only for the harnesses enabled in project.yaml.
  enabled=$(echo $(enabled_harnesses))
  has_harness() { case " $enabled " in *" $1 "*) return 0;; *) return 1;; esac; }
  ok "enabled harnesses: $enabled"
  for wf in "$KIT_DIR"/workflows/*.md; do
    [ -f "$wf" ] || continue
    n=$(basename "$wf" .md)
    ! has_harness claude-code || [ -f "$REPO_ROOT/.claude/commands/ck-$n.md" ] || bad "missing shim .claude/commands/ck-$n.md — run 'craftkit sync'"
    ! has_harness copilot-cli || [ -f "$REPO_ROOT/.github/skills/ck-$n/SKILL.md" ] || bad "missing shim .github/skills/ck-$n/SKILL.md — run 'craftkit sync'"
  done
  for sk in "$KIT_DIR"/skills/*/SKILL.md; do
    [ -f "$sk" ] || continue
    n=$(basename "$(dirname "$sk")")
    [ "$n" = "references" ] && continue
    [ -f "$KIT_DIR/workflows/$n.md" ] && continue
    ! has_harness claude-code || [ -f "$REPO_ROOT/.claude/commands/ck-$n.md" ] || bad "missing shim .claude/commands/ck-$n.md — run 'craftkit sync'"
    ! has_harness copilot-cli || [ -f "$REPO_ROOT/.github/skills/ck-$n/SKILL.md" ] || bad "missing shim .github/skills/ck-$n/SKILL.md — run 'craftkit sync'"
  done
  if has_harness pi; then
    [ -e "$REPO_ROOT/.pi/context" ] && ok ".pi/context wired" || note ".pi/context not wired — run 'craftkit sync'"
  fi

  if [ -d "$PROJ_DIR/overrides" ] && ls "$PROJ_DIR"/overrides/*/SKILL.md >/dev/null 2>&1; then
    note "skill overrides active: $(ls -d "$PROJ_DIR"/overrides/*/ | xargs -n1 basename | tr '\n' ' ')"
  fi
  [ -d "$PROJ_DIR/context/profiles" ] && [ -n "$(ls -A "$PROJ_DIR/context/profiles" 2>/dev/null)" ] \
    && ok "module profiles present" || note "no module profiles yet — run /ck-context-sync in your harness"

  # Every stack_pack referenced in project.yaml must exist in the vendored kit.
  if [ -f "$PROJ_DIR/project.yaml" ]; then
    for p in $(sed -n 's/^[[:space:]]*stack_pack:[[:space:]]*//p' "$PROJ_DIR/project.yaml" | sed 's/[[:space:]]*#.*//' | grep -v '^$' | sort -u); do
      [ -d "$KIT_DIR/stacks/$p" ] && ok "stack pack '$p' installed" || bad "stack pack '$p' not found in .craftkit/stacks/ — see 'craftkit stacks'"
    done
  fi

  [ $fail -eq 0 ] && say "doctor: all checks passed" || die "doctor: failures found"
}

cmd_version() { cat "$KIT_DIR/KIT_VERSION" 2>/dev/null || die "not installed"; }

cmd_stacks() {
  [ -d "$KIT_DIR/stacks" ] || die "no stack packs installed (run init/update with a kit that ships kit/stacks/)"
  say "Available stack packs (set per module via 'stack_pack:' in project.yaml):"
  for d in "$KIT_DIR"/stacks/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    desc=$(sed -n 's/^description:[[:space:]]*"\{0,1\}//p' "$d/pack.yaml" 2>/dev/null | head -1 | sed 's/"$//')
    say "  $n — ${desc:-no description}"
  done
}

cmd_help() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-help}" in
  init)    shift; cmd_init "$@";;
  sync)    shift; run_sync;;
  update)  shift; cmd_update "$@";;
  doctor)  shift; cmd_doctor "$@";;
  stacks)  cmd_stacks;;
  version) cmd_version;;
  help|--help|-h) cmd_help;;
  *) die "unknown command: $1 (try 'craftkit help')";;
esac
