# CraftKit per-repo contract. Generated by `craftkit init` — owned by this
# repo. Review every value, then commit. Skills read this file at the start of
# every run; it is the only place repo-specific facts live.
kit_version: {{KIT_VERSION}}

# Agent harnesses to generate shims for. `craftkit sync` runs only these
# adapters. Available: claude-code, copilot-cli, pi. Edit + re-run sync to
# enable or disable one.
harnesses: [{{HARNESSES}}]

ticket:
  prefixes: [{{TICKET_PREFIX}}]
  commit_format: "{TICKET}: {description}"
  system: jira              # jira | github | linear — controls tickets-skill markup

modules:
  - name: {{MODULE_NAME}}
    path: {{MODULE_PATH}}   # "." for single-module repos, subdir for monorepos
    ownership: team         # team | external (external => read-only)
    stack: "{{STACK}}"
    stack_pack: {{STACK_PACK}}  # optional; `craftkit stacks` lists packs. Empty = generic behavior
    build: "{{BUILD_CMD}}"
    test: "{{TEST_CMD}}"

rules:
  # Files no skill may modify (deps-update has a scoped exemption for
  # dependency VERSION strings only). Fix code to satisfy the rules — never
  # weaken the rules.
  protected_files:
    - "{{PROTECTED_GLOB}}"
  # Framework anchors: deps-update may bump minor/patch but NEVER the major.
  framework_anchors: []     # e.g. [spring-boot, react]
  coverage_min: 80

artifacts:
  dir: artifacts            # one subdir per ticket; commit them (recommended)

escalation:
  dir_pattern: "artifacts/{TICKET}/escalations"
